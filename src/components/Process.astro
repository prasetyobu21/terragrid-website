---
// src/components/Process.astro
---

<section class="process-section" id="how-it-works">
    <div class="process-container">
        <!-- Left Column: Content -->
        <div class="process-content">
            <h2 class="process-title">Three steps to energy independence.</h2>
            
            <div class="steps-list">
                <!-- Step 1 -->
                <div class="step-item">
                    <div class="step-number">01</div>
                    <div class="step-details">
                        <h3>Access</h3>
                        <p>We analyze your roof's sun exposure and your current energy bills to build a custom system design.</p>
                    </div>
                </div>

                <!-- Step 2 -->
                <div class="step-item">
                    <div class="step-number">02</div>
                    <div class="step-details">
                        <h3>Install</h3>
                        <p>Our engineers safely install your solar array and smart battery with zero disruption to your daily life.</p>
                    </div>
                </div>

                <!-- Step 3 -->
                <div class="step-item">
                    <div class="step-number">03</div>
                    <div class="step-details">
                        <h3>Power up</h3>
                        <p>Turn on the system, track your generation in the TerraGrid app, and watch your meter spin backward.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Image Placeholder -->
        <div class="process-image-wrapper">
            <div class="image-placeholder">
                <span>Image Space / Placement</span>
            </div>
        </div>
    </div>
</section>

<style>
    .process-section {
        padding: 8rem 2rem;
        background-color: #ffffff; /* Bright background for contrast against previous dark section */
        color: #0a0a0a;
        display: flex;
        justify-content: center;
        position: relative;
        z-index: 10;
    }

    .process-container {
        max-width: 1200px;
        width: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6rem;
        align-items: center;
    }

    .process-content {
        max-width: 500px;
    }

    .process-title {
        font-size: clamp(2.5rem, 4vw, 3.5rem);
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1.1;
        margin-bottom: 4rem;
        color: #000000;
    }

    .steps-list {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .step-item {
        display: flex;
        gap: 2rem;
        align-items: baseline;
        /* Subtle reveal animation basis */
        opacity: 0.9;
        transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .step-item:hover {
        opacity: 1;
        transform: translateX(10px);
    }

    .step-number {
        font-size: 1.5rem;
        font-weight: 800;
        color: rgba(0, 0, 0, 0.15); /* Light gray for subtle numbering */
        font-variant-numeric: tabular-nums;
        line-height: 1.2;
        transition: color 0.3s ease;
    }

    .step-item:hover .step-number {
        color: rgba(0, 0, 0, 0.4);
    }

    .step-details h3 {
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-bottom: 0.75rem;
        color: #000000;
    }

    .step-details p {
        font-size: 1.1rem;
        line-height: 1.6;
        color: #4b5563; /* Medium gray */
    }

    .process-image-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 600px;
        border-radius: 32px;
        overflow: hidden;
        /* Subtle shadow for depth */
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    }

    .image-placeholder {
        width: 100%;
        height: 100%;
        background: #f3f4f6;
        border: 2px dashed #d1d5db;
        border-radius: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: absolute;
        top: 0;
        left: 0;
        color: #9ca3af;
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        transition: background 0.3s ease;
    }

    .process-image-wrapper:hover .image-placeholder {
        background: #e5e7eb;
    }

    @media (max-width: 992px) {
        .process-container {
            grid-template-columns: 1fr;
            gap: 4rem;
        }

        .process-content {
            max-width: 100%;
        }

        .process-title {
            margin-bottom: 3rem;
        }

        .process-image-wrapper {
            min-height: 400px;
            order: -1; /* Place image above text on smaller screens */
        }
    }
</style>