---
// src/components/Testimonial.astro
---

<section class="testimonial-section" id="impact">
    <div class="testimonial-container">
        <h2 class="testimonial-headline">Join thousands of sustainable households.</h2>

        <div class="testimonial-card-wrapper">
            <div class="testimonial-card">
                <!-- 5-Star Graphic -->
                <div class="stars">
                    <svg viewBox="0 0 24 24" class="star" fill="currentColor">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                    <svg viewBox="0 0 24 24" class="star" fill="currentColor">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                    <svg viewBox="0 0 24 24" class="star" fill="currentColor">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                    <svg viewBox="0 0 24 24" class="star" fill="currentColor">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                    <svg viewBox="0 0 24 24" class="star" fill="currentColor">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                </div>

                <blockquote class="quote">
                    "Switching to TerraGrid was a no-brainer. Not only is my electric bill practically zero, but the app makes it incredibly fun to track how much clean energy my house is generating."
                </blockquote>

                <div class="author-info">
                    <div class="author-avatar-placeholder">
                        <!-- Image placeholder for Sarah's headshot -->
                    </div>
                    <div class="author-details">
                        <span class="author-name">Sarah Jenkins</span>
                        <span class="author-title">Homeowner</span>
                    </div>
                </div>
            </div>
            
            <!-- Decorative background elements for premium feel -->
            <div class="glow-effect"></div>
        </div>
    </div>
</section>

<style>
    .testimonial-section {
        padding: 10rem 2rem;
        background-color: var(--bg-dark); /* Using the dark background for contrast */
        color: var(--text-white);
        display: flex;
        justify-content: center;
        position: relative;
        overflow: hidden;
        z-index: 10;
    }

    .testimonial-container {
        max-width: 900px;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
        z-index: 2;
    }

    .testimonial-headline {
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1.1;
        margin-bottom: 5rem;
        color: #ffffff;
    }

    .testimonial-card-wrapper {
        position: relative;
        width: 100%;
        max-width: 800px;
    }

    .testimonial-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 32px;
        padding: 4rem;
        position: relative;
        z-index: 2;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
        transition: transform 0.4s ease, box-shadow 0.4s ease;
    }

    .testimonial-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 40px 80px rgba(0, 0, 0, 0.5);
    }

    .glow-effect {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 120%;
        height: 120%;
        background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, rgba(0,0,0,0) 70%);
        z-index: 1;
        pointer-events: none;
    }

    .stars {
        display: flex;
        justify-content: center;
        gap: 0.25rem;
        margin-bottom: 2.5rem;
        color: #fbbf24; /* A soft, premium gold/yellow */
    }

    .star {
        width: 24px;
        height: 24px;
    }

    .quote {
        font-size: clamp(1.2rem, 2.5vw, 1.75rem);
        line-height: 1.6;
        font-weight: 400;
        color: var(--text-white);
        margin: 0 0 3rem 0;
        position: relative;
    }

    .quote::before, .quote::after {
        color: rgba(255, 255, 255, 0.1);
        font-size: 3rem;
        position: absolute;
        line-height: 0;
        font-family: Georgia, serif; /* Serifs for classic quotes */
    }

    .quote::before {
        content: '"';
        top: 10px;
        left: -20px;
    }
    
    /* Hide the pseudo-elements on smaller screens where padding is tight */
    @media (max-width: 640px) {
        .quote::before { display: none; }
    }

    .author-info {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
    }

    .author-avatar-placeholder {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background-color: #374151; /* Dark gray placeholder */
        border: 2px solid rgba(255, 255, 255, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
    }

    .author-avatar-placeholder::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 100%);
    }

    .author-details {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
    }

    .author-name {
        font-weight: 700;
        font-size: 1.1rem;
        color: #ffffff;
        letter-spacing: -0.01em;
    }

    .author-title {
        font-size: 0.9rem;
        color: #9ca3af;
    }

    @media (max-width: 768px) {
        .testimonial-section {
            padding: 6rem 1.5rem;
        }

        .testimonial-card {
            padding: 2.5rem 1.5rem;
            border-radius: 24px;
        }

        .quote {
            font-size: 1.1rem;
            margin-bottom: 2rem;
        }

        .stars {
            margin-bottom: 1.5rem;
        }
        
        .star {
            width: 20px;
            height: 20px;
        }
    }
</style>