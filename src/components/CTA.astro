---
// src/components/CTA.astro
import Button from './Button.astro';
---

<section class="cta-section" id="estimate">
    <!-- Abstract Mesh Gradient Background -->
    <div class="mesh-background"></div>
    
    <div class="cta-container">
        <h2 class="cta-headline">Ready to make the switch?</h2>
        <p class="cta-subheadline">Join the TerraGrid network today and take control of your energy future.</p>
        
        <div class="cta-action">
            <Button href="#eligibility" variant="primary">Check My Home's Eligibility</Button>
        </div>
    </div>
</section>

<style>
    .cta-section {
        position: relative;
        padding: 10rem 2rem;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        z-index: 10;
        text-align: center;
        background-color: #ffffff;
    }

    .mesh-background {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: 
            radial-gradient(at 0% 0%, rgba(16, 185, 129, 0.08) 0px, transparent 50%),
            radial-gradient(at 100% 100%, rgba(59, 130, 246, 0.08) 0px, transparent 50%);
        z-index: -1;
    }

    .cta-container {
        position: relative;
        z-index: 2;
        max-width: 800px;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .cta-headline {
        font-size: 3rem;
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        color: #000000;
    }

    .cta-subheadline {
        font-size: 1rem;
        line-height: 1.6;
        color: #4b5563;
        margin-bottom: 3.5rem;
        max-width: 600px;
    }

    .cta-action {
        position: relative;
    }

    /* Target the primary button specifically in this section to ensure it's visible on white */
    .cta-section :global(.t-btn-primary) {
        border: 1px solid #e5e7eb !important;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
    }

    @media (max-width: 768px) {
        .cta-section {
            padding: 8rem 1.5rem;
        }
    }
</style>
