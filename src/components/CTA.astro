---
// src/components/CTA.astro
import Button from './Button.astro';
---

<section class="cta-section" id="estimate">
    <!-- Abstract Mesh Gradient Background -->
    <div class="mesh-background"></div>
    
    <div class="cta-container">
        <h2 class="cta-headline">Ready to make the switch?</h2>
        <p class="cta-subheadline">Join the TerraGrid network today and take control of your energy future.</p>
        
        <div class="cta-action">
            <Button href="#eligibility" variant="primary">Check My Home's Eligibility</Button>
        </div>
    </div>
</section>

<style>
    .cta-section {
        position: relative;
        padding: 12rem 2rem;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        z-index: 10;
        text-align: center;
    }

    /* Modern abstract mesh gradient */
    .mesh-background {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: var(--bg-dark); /* Fallback */
        background-image: 
            radial-gradient(at 0% 0%, rgba(16, 185, 129, 0.15) 0px, transparent 50%),
            radial-gradient(at 100% 100%, rgba(59, 130, 246, 0.15) 0px, transparent 50%),
            radial-gradient(at 100% 0%, rgba(16, 185, 129, 0.05) 0px, transparent 50%),
            radial-gradient(at 0% 100%, rgba(59, 130, 246, 0.05) 0px, transparent 50%);
        z-index: -1;
        opacity: 0.8;
    }

    .cta-container {
        position: relative;
        z-index: 2;
        max-width: 800px;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .cta-headline {
        font-size: clamp(3rem, 6vw, 4.5rem);
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        color: #ffffff;
    }

    .cta-subheadline {
        font-size: clamp(1.1rem, 2vw, 1.35rem);
        line-height: 1.6;
        color: var(--text-gray);
        margin-bottom: 3.5rem;
        max-width: 600px;
    }

    .cta-action {
        /* Adding a subtle glow behind the button to make it pop */
        position: relative;
    }

    .cta-action::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 120%;
        height: 150%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(0,0,0,0) 70%);
        z-index: -1;
        pointer-events: none;
    }

    @media (max-width: 768px) {
        .cta-section {
            padding: 8rem 1.5rem;
        }
    }
</style>