---
// src/components/Navbar.astro
import Button from './Button.astro';
---

<nav class="navbar" id="navbar">
	<div class="nav-container">
		<!-- Left: Logo -->
		<div class="nav-logo">
			<a href="/">
				<img src="/terragrid_logo.svg" alt="TerraGrid" class="logo-img" />
			</a>
		</div>

		<!-- Center: Navigation Links -->
		<ul class="nav-links">
			<li class="dropdown">
				<a href="#products" class="nav-link">Products <span class="arrow">↓</span></a>
				<ul class="dropdown-menu">
					<li><a href="#solar">Solar Solutions</a></li>
					<li><a href="#wind">Wind Energy</a></li>
					<li><a href="#storage">Energy Storage</a></li>
					<li><a href="#monitoring">Smart Monitoring</a></li>
				</ul>
			</li>
			<li><a href="#how-it-works" class="nav-link">How It Works</a></li>
			<li><a href="#impact" class="nav-link">Impact</a></li>
			<li><a href="#about" class="nav-link">About Us</a></li>
		</ul>

		<!-- Right: CTA Button -->
		<div class="nav-cta">
			<Button href="#estimate" variant="primary" class="nav-btn">Get a free estimate</Button>
		</div>
	</div>
</nav>

<script>
	const initNavbar = () => {
		const navbar = document.getElementById('navbar');
		if (navbar) {
			const updateNavbar = () => {
				if (window.scrollY > 50) {
					navbar.classList.add('scrolled');
				} else {
					navbar.classList.remove('scrolled');
				}
			};

			window.addEventListener('scroll', updateNavbar, { passive: true });
			// Call once to set initial state
			updateNavbar();
		}
	};

	// Run on initial load
	initNavbar();
	// Run on view transitions if Astro is configured for it
	document.addEventListener('astro:after-swap', initNavbar);
</script>

<style>
	.navbar {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		z-index: 100;
		padding: 1.5rem 0;
		display: flex;
		justify-content: center;
		pointer-events: none;
	}

	.nav-container {
		width: 95%;
		max-width: 1200px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		background: transparent;
		backdrop-filter: blur(0px);
		-webkit-backdrop-filter: blur(0px);
		border: 1px solid transparent;
		border-radius: 100px;
		padding: 0.4rem 0.6rem 0.4rem 1.5rem;
		pointer-events: auto;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	/* Force visual state so you can explicitly see the change */
	:global(.navbar.scrolled) .nav-container {
		background: rgba(10, 10, 10, 0.75);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
	}

	:global(.navbar.scrolled) .nav-container:hover {
		background: rgba(10, 10, 10, 0.85);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.2);
	}

	.nav-logo {
		flex: 1;
		display: flex;
		align-items: center;
		opacity: 0;
		visibility: hidden;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.logo-img {
		height: 32px;
		width: auto;
		display: block;
	}

	.nav-links {
		display: flex;
		list-style: none;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		align-items: center;
		flex: 1;
		justify-content: center;
	}

	.nav-cta {
		flex: 1;
		display: flex;
		justify-content: flex-end;
		align-items: center;
		opacity: 0;
		visibility: hidden;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	:global(.navbar.scrolled) .nav-logo,
	:global(.navbar.scrolled) .nav-cta {
		opacity: 1;
		visibility: visible;
	}

	/* Custom styling to make the button fit perfectly inside the pill */
	:global(.nav-btn) {
		padding: 0.6rem 1.2rem !important;
		font-size: 0.85rem !important;
	}

	.nav-link {
		color: #ffffff;
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		padding: 0.6rem 1.2rem;
		border-radius: 100px;
		transition: all 0.2s ease;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		white-space: nowrap;
	}

	.nav-link:hover {
		background: rgba(255, 255, 255, 0.1);
	}

	.arrow {
		font-size: 0.7rem;
		opacity: 0.5;
		transition: transform 0.3s ease;
	}

	/* Dropdown Logic */
	.dropdown {
		position: relative;
	}

	.dropdown-menu {
		position: absolute;
		top: calc(100% + 0.5rem);
		left: 50%;
		transform: translateX(-50%) translateY(10px);
		background: rgba(10, 10, 10, 0.95);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 16px;
		min-width: 180px;
		padding: 0.5rem;
		list-style: none;
		opacity: 0;
		visibility: hidden;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
	}

	.dropdown:hover .dropdown-menu {
		opacity: 1;
		visibility: visible;
		transform: translateX(-50%) translateY(0);
	}

	.dropdown:hover .arrow {
		transform: rotate(180deg);
	}

	.dropdown-menu li a {
		color: #ffffff;
		text-decoration: none;
		font-size: 0.85rem;
		display: block;
		padding: 0.7rem 1rem;
		border-radius: 8px;
		transition: background 0.2s ease;
	}

	.dropdown-menu li a:hover {
		background: rgba(255, 255, 255, 0.1);
	}

	/* Tablet/Mobile adjustment */
	@media (max-width: 992px) {
		.nav-logo, .nav-cta {
			display: none; /* Hide logo and CTA on very small screens to save space, or handle responsive differently */
		}
		
		.nav-container {
			width: auto;
			padding: 0.4rem 0.8rem;
		}

		.nav-links {
			flex: unset;
		}
	}

	@media (max-width: 640px) {
		.nav-link {
			padding: 0.5rem 0.8rem;
			font-size: 0.8rem;
		}
	}
</style>